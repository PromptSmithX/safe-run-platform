{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-run.example/schemas/session-reconciliation.schema.json",
  "title": "Safe Run session reconciliation",
  "type": "object",
  "required": ["client_session_ids"],
  "additionalProperties": false,
  "properties": {
    "client_session_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    }
  }
}
