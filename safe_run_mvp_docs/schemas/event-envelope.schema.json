{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-run.local/schemas/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "session_id",
    "seq",
    "watch_timestamp",
    "kind",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "packet_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "watch_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "const": "event"
    },
    "payload": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "severity",
        "incident_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "incident_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "context": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
