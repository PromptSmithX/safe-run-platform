{
  "name": "safe-run-functions",
  "private": true,
  "engines": { "node": "22" },
  "main": "lib/index.js",
  "scripts": {
    "copy-schemas": "node scripts/copy-schemas.mjs",
    "build": "npm run copy-schemas && tsc",
    "typecheck": "npm run copy-schemas && tsc --noEmit",
    "test": "npm run build && node --test lib/tests/unit/*.test.js",
    "test:emulator": "npm run build && node --test --test-concurrency=1 lib/tests/emulator/*.test.js",
    "seed:caregiver": "node scripts/seed-emulator-caregiver.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.1.0",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/express": "5.0.3",
    "firebase": "12.18.0",
    "firebase-tools": "15.29.0",
    "typescript": "5.9.3"
  }
}
